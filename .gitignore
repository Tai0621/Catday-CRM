# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

.vercel
.claude/

# local demo database (fabricated data, machine-local only — see scripts/setup-local-demo.mjs)
/prisma/demo.db
/prisma/demo.db-wal
/prisma/demo.db-shm

# database backups (scripts/backup-db.mjs) — may contain real customer data
/backups/

# Tenant registry — every client's database token. Never commit.
/clients.json

.vercel
.env*
.tmp-*
