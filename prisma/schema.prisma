generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ─── Customer ───────────────────────────────────────────────────────────────

model Customer {
  id               String         @id @default(cuid())
  phone            String         @unique
  name             String?
  email            String?
  address          String?
  source           String         @default("WalkIn")
  marketingConsent Boolean        @default(false)
  // Consent provenance (A4): when consent was given and through which channel —
  // the record a regulator asks for. Set together via lib/consent.ts; cleared
  // when consent is withdrawn. Null = never recorded (legacy or no consent).
  marketingConsentAt     DateTime?
  marketingConsentSource String?   // Staff | GoogleForm | WhatsApp | WalkIn | Import
  needsDetails     Boolean        @default(false)
  // M9 · The language this household actually writes in — CUSTOMER_LANGUAGES.
  // Null means unknown, which is a real answer: the OS then uses the business
  // default rather than guessing, because guessing wrong is worse than being
  // neutral. Detected from inbound WhatsApp text as a HINT only; a value set by
  // a human is never overwritten (lib/language.ts).
  language         String?
  notes            String?
  pointsBalance    Int            @default(0) // loyalty / royalty engine balance
  walletBalance    Float          @default(0) // Cat Day Wallet stored value (RM)
  // Data protection (A3): when set, this record has been anonymised on an
  // erasure request — identifying fields are redacted while de-identified
  // financial rows are retained for the statutory window, then purged by the
  // retention cron (lib/retention.ts). Null = active customer.
  erasedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  cats             Cat[]
  memberships      Membership[]
  appointments     Appointment[]
  transactions     Transaction[]
  whatsappLeads    WhatsAppLead[]
  loyaltyEntries   LoyaltyEntry[]
  walletEntries    WalletEntry[]
  groupSends       GroupSend[]
  reviewRequests   ReviewRequest[]
  academyEnrollments AcademyEnrollment[]

  // M5 · Referrals. The code is this customer's to share; referredBy records who
  // sent them. Self-relation, so a household's origin is traceable without a
  // second lookup table.
  referralCode     String?        @unique
  referredById     String?
  referredBy       Customer?      @relation("CustomerReferral", fields: [referredById], references: [id])
  referred         Customer[]     @relation("CustomerReferral")
  referralsMade    Referral[]     @relation("ReferralReferrer")
  referralReceived Referral[]     @relation("ReferralReferred")
}

// M5 · One referral, from link to credit.
//
// Credit is deliberately NOT awarded inside POS checkout. Data-integrity rule 3
// says everything a checkout creates must be reversible by deleting the sale;
// wiring wallet credit into that path would mean unpicking two customers'
// ledgers on every correction. Instead a manager confirms it from the referrals
// page once the referred customer's first visit is genuinely complete — the same
// propose-then-confirm discipline used everywhere else money moves.
model Referral {
  id               String    @id @default(cuid())
  referrerId       String
  referrer         Customer  @relation("ReferralReferrer", fields: [referrerId], references: [id])
  referredId       String    @unique // a customer can only be referred once
  referred         Customer  @relation("ReferralReferred", fields: [referredId], references: [id])
  status           String    @default("Pending") // Pending | Credited | Void
  referrerCreditRM Float     @default(0)
  referredCreditRM Float     @default(0)
  creditedAt       DateTime?
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([referrerId])
}

// M10 · One outbound marketing message, sent to one customer, from one audience.
//
// Two jobs. It enforces the global frequency cap — a customer who lands in five
// groups must not receive five messages in a week — and it gives M2's
// attribution join something to credit, so targeting becomes measurable rather
// than merely convenient.
//
// Written only when a staff member confirms the send, not when the worklist is
// opened: an unsent message must never suppress a later real one.
model GroupSend {
  id         String   @id @default(cuid())
  groupKey   String   // system group key (lib/customer-groups.ts)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  channel    String   @default("WhatsApp")
  variant    String?  // copy arm, when the group's message is under test
  staffId    String?
  sentAt     DateTime @default(now())

  @@index([customerId, sentAt]) // frequency-cap lookup
  @@index([groupKey, sentAt])
}

// source values: GoogleForm | WhatsApp | WalkIn | Referral | Other

// ─── Cat ────────────────────────────────────────────────────────────────────

model Cat {
  id               String    @id @default(cuid())
  name             String
  breed            String?
  gender           String?   // Male | Female
  dateOfBirth      DateTime?
  lifeStage        String?   // Kitten | Adult | Senior
  coatType         String?   // Short | Long — sets the default rebooking cycle (owner plan: Long 15-20d, Short ~30d)
  foundingNumber   Int?      @unique // Founding Cats permanent number CAT-001…CAT-100
  careNotes        String?   // boarding care instructions: feeding, medication, quirks
  healthNotes      String?
  vaccinationExpiry DateTime? // drives the "vaccination expiring" dashboard alert; annual, mandatory for boarding
  lastDewormAt     DateTime? // parasite control — monthly per boarding SOP; if not current at boarding → RM50 treatment
  lastDefleaAt     DateTime?
  dietType         String?   // Commercial | Prescription | Owner-supplied (DIET_TYPES) — feeding SOP S002
  mealsPerDay      Int?      // null = derive from lifeStage (Adult 2 / Kitten 3 / Senior 2)
  portion          String?   // e.g. "60g" per meal
  feedingNotes     String?   // special feeding instructions
  medication       String?   // meds / supplements given with food
  groomingInterval Int?      // days between sessions; null = use coat/breed default
  // NOTE: cat photos live in MediaAsset (private Blob, ownerType 'cat'), not on
  // this row. The legacy base64 `photos` column was dropped in the A1
  // data-protection round (migrate-drop-cat-photos.mjs) — do not reintroduce it.
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointments     Appointment[]
  transactionLines TransactionLine[]
  assessments      CatAssessment[]
}

// ─── Cat Assessment (美容师诊断建档 — groomer diagnosis record per visit) ────

model CatAssessment {
  id            String   @id @default(cuid())
  catId         String
  cat           Cat      @relation(fields: [catId], references: [id])
  skinCondition String?  // Healthy | Dry | Flaky | Oily | Irritated
  coatCondition String?  // Healthy | Dry | Oily | Matted | Heavy shedding
  earCondition  String?  // Clean | Waxy | Needs attention
  nailCondition String?  // Trimmed | Due | Overgrown
  stressLevel   String?  // Low | Medium | High
  weightKg      Float?
  findings      String?  // objective diagnosis notes — no upselling, per SOP
  carePlan      String?  // quarterly home-care plan handed to the owner
  rebookDays    Int?     // recommended next-visit cycle; copied to Cat.groomingInterval
  createdAt     DateTime @default(now())

  @@index([catId])
}

// ─── Membership Tier ────────────────────────────────────────────────────────

model MembershipTier {
  id                   String   @id @default(cuid())
  name                 String   @unique
  tagline              String?  // short descriptor e.g. "By invitation only"
  monthlyPrice         Float
  annualPrice          Float?
  groomingCredits      Int      @default(0) // sessions per month included
  boardingDiscount     Float    @default(0) // percentage off boarding
  qualification        String   @default("Manual") // Auto | Spending | Invitation | Paid | Manual
  annualSpendThreshold Float?   // ringgit/year to qualify (Spending tiers)
  pointsMultiplier     Float    @default(1) // loyalty accrual rate
  cardType             String   @default("Digital") // Digital | Matte | Collectible
  benefits             String?  // JSON array of benefit strings
  color                String?  // hex for UI badge
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  memberships          Membership[]
}

// ─── Membership ──────────────────────────────────────────────────────────────

model Membership {
  id           String         @id @default(cuid())
  customerId   String
  customer     Customer       @relation(fields: [customerId], references: [id])
  tierId       String
  tier         MembershipTier @relation(fields: [tierId], references: [id])
  memberNumber Int?           // sequential card number (e.g. Founder Circle #001–100)
  startDate    DateTime
  expiryDate   DateTime
  status       String         @default("Active") // Active | Expired | Cancelled | Paused
  creditsUsed  Int            @default(0)
  autoRenew    Boolean        @default(false)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([customerId])
  @@index([status])
}

// ─── Loyalty (Royalty Engine) ────────────────────────────────────────────────

model LoyaltyEntry {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  points     Int      // positive = earned, negative = redeemed
  reason     String   // GroomingCompleted | GoogleReview | SocialPost | Referral | EventAttendance | BirthdayCelebration | EarlyBooking | MultiCat | Redemption | Manual
  note       String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ─── Staff (individual PIN logins, roles drive staff vs management views) ────

model Staff {
  id        String   @id @default(cuid())
  name      String
  role      String   // Manager | FrontDesk | Groomer | Boarding
  pinHash   String   @unique // salted scrypt of the personal PIN (legacy sha256 upgraded on login)
  active    Boolean  @default(true)
  commissionRatePct Float? // per-groomer commission override (see lib/commission.ts)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  careTasks      CareTask[]
  boardingChecks BoardingCheck[]
  dailyCareLogs  DailyCareLog[]
  timeEntries    TimeEntry[]
  leaveRequests  LeaveRequest[]
}

// ─── Service menu (single source of truth for prices & durations) ────────────

model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String   // Grooming | Bath | Diagnosis | Boarding | AddOn
  durationMin Int      @default(60)
  price       Float
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  commissionRatePct Float? // per-service groomer commission override (see lib/commission.ts)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
}

// ─── Boarding run sheet (daily care checklist per stay) ──────────────────────

// Boarding check-in / check-out record (SOP S004 baseline). One row per phase
// per stay: room + cat condition, notes, and (checkout) whether all belongings
// were returned. Photos attach via MediaAsset (ownerType 'condition').
model BoardingCheck {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  phase         String // CheckIn | CheckOut
  roomCondition String? // ROOM_CONDITIONS
  catCondition  String? // comma-joined CAT_CONDITIONS
  allCollected  Boolean     @default(false) // checkout: every belonging returned
  notes         String?
  staffId       String?
  staff         Staff?      @relation(fields: [staffId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

// A personal belonging the customer brought at check-in, ticked off as returned
// at check-out (photos via MediaAsset ownerType 'belongings').
model BoardingItem {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  label         String
  returned      Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
}

// Structured daily health & behaviour log (SOP S004) — one row per stay per day
// per period (AM/PM). Tap-to-select fields, not free text, so low-literacy staff
// can log fast and red flags are machine-detectable. See lib/care-log.ts.
model DailyCareLog {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  catId         String
  date          String // YYYY-MM-DD
  period        String // AM | PM
  appetite      String? // LOG_APPETITE
  stool         String? // LOG_STOOL
  urine         String? // LOG_URINE
  energy        String? // LOG_ENERGY
  behavior      String? // comma-joined LOG_BEHAVIOR
  respiratory   String? // LOG_RESPIRATORY
  skin          String? // LOG_SKIN
  vomiting      Boolean     @default(false)
  notes         String?
  staffId       String?
  staff         Staff?      @relation(fields: [staffId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([appointmentId, date, period])
  @@index([appointmentId])
}

model CareTask {
  id            String    @id @default(cuid())
  date          String    // "YYYY-MM-DD"
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  catId         String
  task          String
  done          Boolean   @default(false)
  staffId       String?
  staff         Staff?    @relation(fields: [staffId], references: [id])
  doneAt        DateTime?
  createdAt     DateTime  @default(now())

  @@unique([date, appointmentId, task])
}

// ─── Daily cash-up (front desk reconciliation, bridge to Finance) ────────────

model CashUp {
  id         String   @id @default(cuid())
  date       String   @unique // "YYYY-MM-DD"
  expectedRM Float
  countedRM  Float
  variance   Float
  note       String?
  staffName  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Expenses (cost side of the income statement) ────────────────────────────

model Expense {
  id        String    @id @default(cuid())
  date      DateTime
  category  String    // see EXPENSE_CATEGORIES in lib/finance.ts (Rent, Salaries, …)
  amount    Float
  notes     String?
  vendor    String?   // supplier — for accounts-payable tracking
  paid      Boolean   @default(true)  // unpaid = an account payable
  dueDate   DateTime? // when it's due (for A/P aging)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([date])
  @@index([paid])
}

// ─── Statement overrides (accountant's hard-keyed cells — render blue) ───────

model StatementCell {
  id        String   @id @default(cuid())
  year      Int
  month     Int      // 0-11
  rowKey    String   // rev:<Category> | cogs:<Category> | opex:<Category> | tax | custom:<rowDefId>
  amount    Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, rowKey])
}

// Accountant-added statement rows (fully manual, deletable) — e.g. Depreciation
model StatementRowDef {
  id        String   @id @default(cuid())
  year      Int
  section   String   // rev | cogs | opex
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Business configuration (key → value string, parsed by lib/config.ts) — the
// productization seam: everything client-specific (name, currency, hours, tax)
// lives here as data, not code. Single-tenant today; a future multi-tenant
// build makes this @@id([orgId, key]) — a purely additive change.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Generic photo/video attachment stored in Vercel Blob. One shared model so
// every feature (cat profile photos, grooming before/after, boarding belongings
// & condition shots) reuses the same upload/list/delete plumbing. `ownerType` +
// `ownerId` link it to whatever it belongs to; `tag` sub-classifies within an
// owner (e.g. 'before' | 'after' | 'belongings' | 'room' | 'condition').
// See lib/media.ts and app/components/MediaSection.tsx.
model MediaAsset {
  id          String   @id @default(cuid())
  url         String // public Blob URL
  pathname    String // Blob pathname — needed to delete the blob
  kind        String // image | video
  contentType String
  size        Int // bytes
  ownerType   String // cat | assessment | appointment | ...
  ownerId     String
  tag         String?
  caption     String?
  uploadedBy  String? // staff id, when known
  createdAt   DateTime @default(now())

  @@index([ownerType, ownerId])
}

// Append-only audit trail for sensitive/financial actions — who did what, when.
// Written best-effort by lib/audit.ts recordAudit(); a write failure never
// blocks the underlying operation. Read-only manager view at /admin/audit.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorKind  String // manager | staff
  actorId    String? // staff id when known
  actorName  String
  action     String // dotted verb, e.g. transaction.delete, staff.create, wallet.topup
  entityType String // Transaction | Staff | Customer | ...
  entityId   String?
  summary    String // human-readable one-liner
  detail     String? // optional JSON blob
  ip         String?

  @@index([at])
  @@index([entityType, entityId])
}

// HR · time clock. One row per shift: a clock-in that later gets a clock-out.
// Anti-buddy-punch = a required selfie (MediaAsset) + the IP each punch came
// from, checked against the on-premises allowlist (see lib/hr.ts). onPremise
// flags are null when the allowlist isn't configured yet.
model TimeEntry {
  id              String    @id @default(cuid())
  staffId         String
  staff           Staff     @relation(fields: [staffId], references: [id])
  clockInAt       DateTime  @default(now())
  clockOutAt      DateTime?
  clockInPhotoId  String? // MediaAsset id (ownerType 'timeclock')
  clockOutPhotoId String?
  clockInIp       String?
  clockOutIp      String?
  onPremiseIn     Boolean?
  onPremiseOut    Boolean?
  note            String?
  createdAt       DateTime  @default(now())

  @@index([staffId, clockInAt])
  @@index([clockInAt])
}

// HR · recruiting. A candidate applies through the public /careers form; the
// manager moves them through the pipeline (New → Reviewing → Interview →
// Hired/Rejected) on /hr/applications.
model JobApplication {
  id           String    @id @default(cuid())
  name         String
  phone        String
  email        String?
  roleApplied  String?
  experience   String? // free text: experience / message
  availability String? // when they can start / hours
  status       String    @default("New") // New | Reviewing | Interview | Hired | Rejected
  notes        String? // manager's internal notes
  source       String    @default("Careers form")
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// HR · leave. Staff request; a manager approves/rejects. Day-level dates are
// stored as "YYYY-MM-DD" strings (project convention for period identifiers),
// which keeps calendar overlap a simple string comparison.
model LeaveRequest {
  id         String    @id @default(cuid())
  staffId    String
  staff      Staff     @relation(fields: [staffId], references: [id])
  type       String // Annual | Medical | Emergency | Unpaid
  startDate  String // YYYY-MM-DD
  endDate    String // YYYY-MM-DD
  days       Int
  reason     String?
  status     String    @default("Pending") // Pending | Approved | Rejected
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([staffId])
}

// Administrative — Fixed Asset Register. Each asset depreciates straight-line
// over usefulLifeMonths down to salvageValue. Finance reads these (never writes
// back): net book value auto-fills the balance-sheet fixed-assets line, the
// monthly charge posts as a Depreciation line on the income statement (so
// retained earnings absorbs it and the sheet stays balanced), and purchases
// flow to cash-flow investing. Until the first asset exists, statements are
// unchanged — the fixed-assets line stays accountant-keyed. See lib/assets.ts.
model FixedAsset {
  id               String   @id @default(cuid())
  name             String
  category         String // ASSET_CATEGORIES in lib/assets.ts
  cost             Float // acquisition cost (RM)
  salvageValue     Float    @default(0) // residual value at end of life (RM)
  purchaseDate     DateTime // depreciation starts this month
  usefulLifeMonths Int // straight-line life
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([purchaseDate])
}

// Administrative — Licenses & Renewals. Compliance items with an expiry
// (business/health/fire permits, insurance, certifications). Each surfaces in
// the Action Inbox `reminderDays` ahead of `renewalDate`; renewing = pushing
// renewalDate forward. Archived items are hidden but kept for history. See
// lib/actions.ts (LicenseRenewal rule) and LICENSE_CATEGORIES in lib/constants.
model License {
  id           String   @id @default(cuid())
  name         String
  category     String // LICENSE_CATEGORIES in lib/constants.ts
  authority    String? // issuing body, e.g. DBKL, Bomba
  licenseNo    String?
  issueDate    DateTime?
  renewalDate  DateTime // next expiry / renewal-due date — drives the alert
  reminderDays Int      @default(30) // lead time to surface the renewal action
  cost         Float? // renewal fee (RM), informational
  notes        String?
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([archived, renewalDate])
}

// Driver-based financial plan inputs (key → value), e.g. cap.boardingPrice,
// util.endPct, opex.Rent. Flexible so the model can grow without migrations.
model PlanDriver {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Float
  updatedAt DateTime @updatedAt
}

// Balance sheet — accountant-keyed lines (blue), per as-of month-end.
// OS-derived lines (receivables, wallet, retained earnings) are computed live,
// never stored. Finance-only: nothing here writes back to operations.
model BalanceSheetCell {
  id        String   @id @default(cuid())
  asOf      String   // "YYYY-MM" (month-end the balance sheet is struck at)
  lineKey   String   // a.cash | a.inventory | l.loans | e.capital | …
  amount    Float
  updatedAt DateTime @updatedAt

  @@unique([asOf, lineKey])
}

// Accountant's custom row order per section (drag-to-reorder). orderJson is a
// JSON array of rowKeys; rows not listed fall to the end in default order.
model StatementRowOrder {
  id        String   @id @default(cuid())
  year      Int
  section   String   // rev | cogs | opex
  orderJson String
  updatedAt DateTime @updatedAt

  @@unique([year, section])
}

// Built-in rows the accountant removed from a year's statement (restorable —
// the underlying OS data is never touched)
model StatementHiddenRow {
  id        String   @id @default(cuid())
  year      Int
  rowKey    String   // rev:<Category> | cogs:<Category> | opex:<Category>
  createdAt DateTime @default(now())

  @@unique([year, rowKey])
}

// ─── Cat Day Wallet (储值 stored value — liability until spent) ──────────────

model WalletEntry {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Float    // positive = top-up/bonus, negative = payment from wallet
  kind       String   // TopUp | Bonus | Spend | Adjustment
  note       String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ─── Room ────────────────────────────────────────────────────────────────────

model Room {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String   @default("Standard") // Standard | Suite | DayStay
  capacity    Int      @default(2) // cats the room can hold at once (Standard 2, Suite 6); boarding priced per cat
  description String?
  status      String   @default("Available") // Available | Occupied | Cleaning | Maintenance
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
}

// ─── Appointment ─────────────────────────────────────────────────────────────

model Appointment {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  catId       String
  cat         Cat      @relation(fields: [catId], references: [id])
  type        String   // Grooming | Boarding | Bath | Diagnosis | Other
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  staffId     String?  // allocated groomer / carer
  staff       Staff?   @relation(fields: [staffId], references: [id])
  scheduledAt DateTime
  endsAt      DateTime?
  status      String   @default("Scheduled") // Scheduled | CheckedIn | InService | QualityCheck | Ready | Completed | NoShow | Cancelled
  roomId      String?
  room        Room?    @relation(fields: [roomId], references: [id])
  price       Float?
  depositRM   Float?   // taken at booking (mainly boarding)
  paid        Boolean  @default(false) // drives the "outstanding payments" dashboard alert
  notes       String?
  staffNotes  String?
  usedCredit  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  careTasks        CareTask[]
  transactionLines TransactionLine[]
  boardingChecks   BoardingCheck[]
  boardingItems    BoardingItem[]
  dailyCareLogs    DailyCareLog[]

  @@index([customerId])
  @@index([catId])
  @@index([status])
  @@index([scheduledAt])
}

// ─── Transaction ─────────────────────────────────────────────────────────────

model Transaction {
  id         String   @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  date       DateTime
  total      Float
  category   String   // Grooming | Boarding | Retail | Membership | Academy | Other
  method     String?  // Cash | Card | QR | Wallet — drives the daily cash-up
  reference  String?
  notes      String?
  createdAt  DateTime @default(now())

  // Digital receipt: an unguessable slug lets the customer open a public,
  // login-free receipt link (sent over WhatsApp). Lives on the primary row
  // (the one carrying the lines); siblings are found via `reference`.
  publicToken    String?   @unique
  receiptSentAt  DateTime? // when the digital receipt was last shared
  receiptChannel String?   // WhatsApp | Email (email deferred until a sender domain is set)

  lines      TransactionLine[]

  @@index([customerId])
  @@index([date])
  @@index([reference])
}

model TransactionLine {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  catId         String?
  cat           Cat?        @relation(fields: [catId], references: [id])
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  appointmentId String?     // the visit this line settled (lets a delete re-open it)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  description   String
  quantity      Int         @default(1)
  unitPrice     Float
  subtotal      Float

  @@index([transactionId])
  @@index([appointmentId])
}

// ─── Retail products (POS catalog — also the seed of the Inventory round) ────

model Product {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Float    // sell price
  costPrice Float    @default(0) // unit cost — for COGS + inventory-at-cost on the balance sheet
  stockQty  Int      @default(0)
  reorderLevel Int?   // low-stock threshold; at or below → Action Inbox reorder alert
  sku       String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines          TransactionLine[]
  stockMovements StockMovement[]
}

// Inventory ledger. Product.stockQty is the cached running balance; every change
// to it — a POS sale, a delete-reversal, a manual receive/adjust/wastage — writes
// a StockMovement in the same transaction (the ledger+balance rule). The history
// explains why stock is where it is.
model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  delta     Int // + received / - sold or wastage
  reason    String // Sale | SaleReversal | Restock | Adjustment | Wastage | InitialStock
  reference String? // POS reference, supplier note, etc.
  note      String?
  staffId   String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

// ─── WhatsApp ────────────────────────────────────────────────────────────────

model WhatsAppMessage {
  id          String   @id @default(cuid())
  externalId  String?  @unique
  senderPhone String
  content     String
  timestamp   DateTime
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  leads       WhatsAppLead[]
}

model WhatsAppLead {
  id             String          @id @default(cuid())
  messageId      String
  message        WhatsAppMessage @relation(fields: [messageId], references: [id])
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id])
  type           String          // BookingRequest | Inquiry | Complaint | Reschedule | Cancellation | Other
  status         String          @default("Pending") // Pending | Confirmed | Dismissed
  summary        String
  proposedAction String?         // JSON: suggested appointment details
  confidence     Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ─── Incident (Safety incidents & complaints) ────────────────────────────────

model Incident {
  id          String    @id @default(cuid())
  type        String    // Safety | Complaint
  description String
  customerId  String?
  catId       String?
  resolved    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// M4 · A sentiment-gated review request.
//
// The gate is the whole design. Asking "how did today go?" BEFORE showing a
// public review link means a happy customer is routed to Google and an unhappy
// one is routed into service recovery — a complaint becomes an Incident someone
// can fix, instead of a one-star review nobody can.
//
// This is not review-gating in the prohibited sense: the negative path leads to
// a real apology and a real fix, and nothing prevents anyone reviewing publicly
// on their own. What it avoids is *soliciting* a public review from someone the
// business has just let down.
model ReviewRequest {
  id            String    @id @default(cuid())
  token         String    @unique // unguessable slug for the public page
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  appointmentId String?
  sentAt        DateTime  @default(now())
  respondedAt   DateTime?
  sentiment     String?   // Positive | Negative — null until they answer
  clickedAt     DateTime? // followed through to the public review site
  incidentId    String?   // the recovery this turned into, when negative
  staffId       String?

  @@index([customerId, sentAt])
  @@index([sentAt])
}

// C1 · Daily AI spend, one row per day.
//
// The copilot is reachable from every page, so a stuck loop or an enthusiastic
// afternoon could run up real cost on a tenant who never agreed to it. The
// budget is checked BEFORE each call and the actual usage recorded after, so the
// limit is enforced against what was really spent rather than an estimate.
//
// Date is a "YYYY-MM-DD" string, matching the period-identifier convention used
// for CashUp and CareTask.
model AiUsage {
  id           String   @id @default(cuid())
  date         String   @unique
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  calls        Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// C2 · A write the assistant wants to make, held until a human confirms it.
//
// The proposal is stored server-side rather than handed to the browser and
// posted back, for three reasons that are all about correctness rather than
// distrust of the logged-in manager (who could make the same write by hand):
//
//   1. Single use. `status` moves Pending → Confirmed exactly once, so a
//      double-clicked Confirm cannot produce two appointments.
//   2. Honest audit. The arguments executed are the arguments the model
//      proposed, not whatever the client last held.
//   3. A record of what was DECLINED, which is the more interesting half — a
//      proposal type nobody ever confirms is a tool that should not exist.
//
// Proposals expire (see PROPOSAL_TTL_MIN): "book Mochi in tomorrow at 2pm" is
// wrong if it is confirmed three days later.
model AiProposal {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  kind      String // whatsapp | appointment | careNote | reorder | expense
  payload   String // JSON, exactly as validated when proposed
  summary   String // the one-liner the confirm card shows
  prompt    String // the question that produced it
  status    String    @default("Pending") // Pending | Confirmed | Declined
  decidedAt DateTime?
  resultId  String? // id of the row the confirmed write created
  error     String? // why execution failed, when it did

  @@index([status, createdAt])
  @@index([createdAt])
}

// C5 · The nightly analyst brief. One row per business day, written just after
// local midnight by /api/cron/daily-brief.
//
// `facts` is the computed snapshot the narration was written from, stored
// verbatim. Without it a brief read three weeks later cannot be checked against
// anything — the underlying rows have moved on, and "revenue was soft on the
// 12th" becomes an unfalsifiable claim. It is also what makes the model's role
// auditable: every figure in `observations` must appear here.
//
// `date` is a tenant-LOCAL day key (lib/timezone.ts), not a UTC one.
model DailyBrief {
  id           String   @id @default(cuid())
  date         String   @unique // YYYY-MM-DD, tenant local
  createdAt    DateTime @default(now())
  facts        String // JSON — BriefFacts
  observations String // JSON — string[]
  actions      String // JSON — { title, why, href }[]
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)

  @@index([createdAt])
}

// C9 · One department's report for one closed month.
//
// `facts` is written FIRST and always, whether or not the narrative can be
// generated: the fact tables are useful on their own and carry no AI risk, so
// the report fails closed on the model without failing on the report.
//
// `status`:
//   Facts     — figures only; no key, no budget, or narration failed
//   Published — narrative generated and every number in it traced to the facts
//   Flagged   — narrative generated but contains a figure the facts do not
//               support. Kept, not deleted: the facts are still sound and the
//               unsupported figures are named on screen. See lib/reports/grounding.ts.
model MonthlyReport {
  id           String   @id @default(cuid())
  month        String // YYYY-MM
  department   String // lib/reports/facts/index.ts
  facts        String // JSON — the department's computed figures
  headline     String?
  observations String? // JSON — string[]
  actions      String? // JSON — { title, why, href }[]
  status       String   @default("Facts") // Facts | Published | Flagged
  unsupported  String? // JSON — figures the grounding check could not trace
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  generatedAt  DateTime @default(now())

  @@unique([month, department])
  @@index([month])
}

// C6 · A generated starting configuration for a new client.
//
// Kept after committing rather than discarded: it is the record of what the
// business was set up from, and the paragraph that produced it is often the
// clearest statement of what the client actually does that anyone ever writes
// down. `committed` lists the groups already applied, so a half-finished
// onboarding survives closing the tab.
model OnboardingPlan {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  description  String // the paragraph the owner wrote
  plan         String // JSON — lib/onboarding/plan.ts
  committed    String   @default("[]") // JSON — PlanGroup[]
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)

  @@index([createdAt])
}

// M6 · An enquiry from the public page.
//
// Deliberately NOT an Appointment. An unauthenticated stranger must never be
// able to write into the diary — the slot engine, room capacity and pricing all
// assume the caller is staff. This is a lead that a human turns into a booking,
// and `appointmentId` records that moment, which is also what makes the funnel
// (view → request → booked → showed) joinable at all.
model BookingRequest {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  name          String
  phone         String
  email         String?
  catName       String?
  serviceName   String? // free text — what they asked for, not a Service FK
  preferredDate String? // YYYY-MM-DD
  notes         String?
  status        String    @default("New") // New | Contacted | Booked | Declined
  appointmentId String? // set when this became a real booking
  handledBy     String?
  handledAt     DateTime?

  @@index([status, createdAt])
  @@index([createdAt])
}

// M6 · Daily public-page view counter.
//
// One row per day rather than one per hit: the page is public, so a per-hit
// table would be an unbounded write target for anyone with curl. Bots are
// filtered by user agent before counting, which reduces the noise without
// pretending to eliminate it.
model PublicPageView {
  date      String   @id // YYYY-MM-DD, tenant local
  views     Int      @default(0)
  requests  Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ─── Action Inbox log (Done/Dismissed/Snoozed decisions) ─────────────────────

model ActionLog {
  id          String    @id @default(cuid())
  actionKey   String    // "type:refId" — identifies the underlying suggestion
  type        String    // OutstandingPayment | VipArrival | RebookCheckout | WinBack | MembershipExpiry | VaccinationExpiry | GroomingDue | Birthday | GoldEligible
  customerId  String?
  catId       String?
  status      String    // Done | Dismissed | Snoozed
  snoozeUntil DateTime?
  note        String?
  variant     String?   // C4 · ActionVariant.label the customer was shown, when the type is under test
  createdAt   DateTime  @default(now())

  @@index([actionKey])
  // C3 · the learning pass reads every outcome for a type over a rolling year
  @@index([type, createdAt])
}

// C4 · Competing message copy for one Action Inbox type. Every win-back message
// the business has ever sent was the same sentence and nobody knew whether it
// worked; a type with variants assigns them deterministically by customer (so a
// person never gets whiplash between voices) and the conversion join in
// lib/actions-learning.ts scores them against each other.
//
// A type with no rows here keeps its built-in template — variants are opt-in per
// type, so adding this changed no existing behaviour.
model ActionVariant {
  id        String   @id @default(cuid())
  type      String   // ActionType under test
  label     String   // short human name, recorded on ActionLog.variant
  body      String   // message template — {cat} {brand} {customer} {days} placeholders
  isActive  Boolean  @default(true)  // in rotation
  isDefault Boolean  @default(false) // the promoted winner; used when rotation is off
  // M9 · Which language this wording is written in (CUSTOMER_LANGUAGES).
  // Null = language-neutral, and eligible for anyone.
  //
  // Localisation rides on the A/B machinery deliberately: a business writes its
  // win-back message once per language and each household gets theirs, with no
  // translation step at send time and no per-message model call. The arms
  // within a language still compete normally, so copy testing and localisation
  // do not fight each other.
  language  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, label])
  @@index([type, isActive])
}

// ─── Business Plan (Breakeven targets) ───────────────────────────────────────

model BusinessPlan {
  id             String   @id @default("default") // singleton row
  startMonth     String   // "YYYY-MM" plan start
  breakevenMonth String   // "YYYY-MM" target breakeven
  avgSaleValue   Float    @default(0) // RM per closed sale, to convert revenue → sales count
  currency       String   @default("RM")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MonthlyTarget {
  id            String   @id @default(cuid())
  month         String   @unique // "YYYY-MM"
  revenueTarget Float    @default(0)
  costBudget    Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Academy ─────────────────────────────────────────────────────────────────

// M7 · An Academy enrolment.
//
// `customerId` is what turns this segment from a brochure into a funnel. Until
// it existed an attendee was a name in a list with no connection to the CRM, so
// "did any of these people ever book a groom?" was unanswerable — which is the
// only question that matters, because workshops are lead generation for
// grooming, not a product line.
//
// Nullable on purpose: someone can attend a workshop without ever becoming a
// customer, and that is exactly the population worth chasing. Matching is by
// normalised phone first, then email (lib/academy.ts).
//
// Conversion is DERIVED, never stored — the first grooming booking after the
// enrolment date, read live. A stored `convertedAt` would need keeping in sync
// with every booking, deletion and correction, and would be wrong the first
// time someone edited an appointment.
model AcademyEnrollment {
  id          String    @id @default(cuid())
  studentName String
  email       String
  phone       String?
  course      String
  status      String    @default("Pending") // Pending | Active | Completed | Withdrawn
  enrolledAt  DateTime  @default(now())
  notes       String?
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
  @@index([enrolledAt])
}
